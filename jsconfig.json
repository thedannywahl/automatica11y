{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "bin",
    "src",
    "test"
  ],
  "exclude": [
    "test/fixtures",
    "node_modules"
  ]
}
