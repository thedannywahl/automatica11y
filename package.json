{
  "name": "automatica11y",
  "version": "0.4.1",
  "description": "Test and compare the accessibility of web pages, Storybook builds, and npm component libraries.",
  "homepage": "https://automatica11y.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/automatica11y.git"
  },
  "bugs": {
    "url": "https://github.com/thedannywahl/automatica11y/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "automatica11y": "bin/automatica11y.js",
    "a11y": "bin/automatica11y.js"
  },
  "files": [
    "bin",
    "src",
    "AGENTS.md",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "tsc -p jsconfig.json",
    "update-wcag": "node scripts/update-wcag.js",
    "docs:build": "node scripts/build-docs.js",
    "docs:preview": "node scripts/build-docs.js && npx --yes serve site",
    "prepublishOnly": "npm run lint"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "accessibility-checker-engine": "^4.0.34",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@pantoken/components": "^2.0.2",
    "@pantoken/css": "^0.4.3",
    "@pantoken/plugin-custom-theme-colors": "^0.3.3",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@types/node": "^26.6.4",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "testing",
    "storybook",
    "web-components",
    "react"
  ]
}
