{
  "name": "automatica11y",
  "version": "0.11.0",
  "description": "Test and compare the accessibility of web pages, Storybook builds, and npm component libraries.",
  "homepage": "https://automatica11y.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/automatica11y.git"
  },
  "bugs": {
    "url": "https://github.com/thedannywahl/automatica11y/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "automatica11y": "bin/automatica11y.js",
    "a11y": "bin/automatica11y.js"
  },
  "files": [
    "bin",
    "src",
    "AGENTS.md",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-release-version.js",
    "release": "changeset publish",
    "test": "node --test --test-concurrency=2 --test-reporter=spec test/*.test.js",
    "test:release": "AUTOMATICA11Y_SKIP_VITEPRESS_A11Y=1 npm test",
    "lint": "tsc -p jsconfig.json",
    "eval:bootstrap": "waza run evals/automatica11y/wazaEval.yaml -v",
    "eval:runner": "waza run evals/automatica11y-runner/wazaEval.yaml -v",
    "eval:runner:e2e": "waza run evals/e2e/automatica11y-runner/wazaEval.yaml -v",
    "update-wcag": "node scripts/update-wcag.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "npm run docs:build && vitepress preview docs",
    "prepublishOnly": "npm run lint"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "accessibility-checker-engine": "^4.0.34",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@changesets/cli": "^3.0.3",
    "@pantoken/components": "^2.0.2",
    "@pantoken/css": "^0.4.3",
    "@pantoken/plugin-custom-icons": "^0.3.14",
    "@pantoken/plugin-custom-theme-colors": "^0.3.3",
    "@pantoken/plugin-simple-icons": "^0.3.12",
    "@pantoken/vitepress": "0.3.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@types/node": "^26.6.4",
    "bits-ui": "^2.19.5",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-llms": "^1.14.0",
    "vue": "^3.5.43",
    "zone.js": "^0.16.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "testing",
    "storybook",
    "web-components",
    "react"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
